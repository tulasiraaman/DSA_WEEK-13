class Solution {
    public int robbbbbbbbb(int[] nums) {
        int[] dp = new int[nums.length];
        Arrays.fill(dp, -1);
        return solve(nums, nums.length-1, dp);
    }

    // memoization, TC - O(N), SC - O(2N)
    private int solve(int[] nums, int idx, int[] dp) {
        if(idx < 0) return 0;
        if(dp[idx] != -1) return dp[idx];

        int pick = nums[idx] + solve(nums, idx-2, dp);
        int nonPick = 0 + solve(nums, idx-1, dp);

        return dp[idx] = Math.max(pick, nonPick);
    }

    // usual recursion, TC - O(2 power N), SC - O(2N)
    private int solve(int[] nums, int idx) {
        if(idx < 0) return 0;
        if(idx == 0) return nums[0];

        int pick = nums[idx] + solve(nums, idx-2);
        int nonPick = 0 + solve(nums, idx-1);

        return Math.max(pick, nonPick);
    }

    // tabulation, TC - O(N), SC - O(N)
    public int robb(int[] nums) {
        int n = nums.length;
        int[] dp = new int[n];
        if(n == 0) return 0;
        if(n == 1) return nums[0];

        dp[0] = nums[0];
        dp[1] = Math.max(nums[0], nums[1]);

        for(int i = 2;i < n;i++){
            dp[i] = Math.max(dp[i-1], nums[i]+dp[i-2]);
        }
        return dp[n-1];
    }

    // optimal, TC - O(N), SC - O(2)
    public int rob(int[] nums) {
        int prev2 = 0, prev1 = 0;
        for(int num: nums){
            int cur = Math.max(prev1, num+prev2);
            prev2 = prev1;
            prev1 = cur;
        }
        return prev1;
    }
}
