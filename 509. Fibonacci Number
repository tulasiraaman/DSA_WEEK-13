class Solution {
    private Map<Integer, Integer> memoMap = new HashMap<>();

    public int fib(int n) {
        if(n <= 1) return n;
        int prev2 = 0;
        int prev1 = 1;
        int cur = 0;
        for(int i = 2;i <= n;i++){
            cur = prev1 + prev2;
            prev2 = prev1;
            prev1 = cur;
        }
        return cur;
    }// TC - O(N), SC - O(2)

    public int ffib(int n) {
        // Tabulation
        if(n <= 1) return n;
        int dp[] = new int[n+1];
        dp[0] = 0;
        dp[1] = 1;
        for(int i = 2;i <= n;i++){
            dp[i] = dp[i-2] + dp[i-1];
        }
        return dp[n];
    }// TC - O(N), SC - O(N)

    public int fiib(int n) {
        if(n <= 1) return n;
        if(memoMap.containsKey(n)) return memoMap.get(n);
        int res = fib(n-1)+fib(n-2);
        memoMap.put(n, res);
        return res;
    }// TC - O(N), SC - O(2N)

    public int fibb(int n) {
        if(n < 1) return 0;
        if(n == 1) return 1;
        return fib(n-1)+fib(n-2);
    }// TC - O(2^n), SC - O(n)
}
